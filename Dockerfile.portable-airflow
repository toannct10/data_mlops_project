ARG AIRFLOW_BASE_IMAGE=apache/airflow:slim-2.11.1-python3.12@sha256:e06e658c63aebd1d29947f9a2e7e2eee536cb8a1f8e7e261a991238610932ede
FROM ${AIRFLOW_BASE_IMAGE}
WORKDIR /app
ARG INSTALL_DEPS=true
COPY requirements-airflow.txt requirements-portable.txt requirements-dbt.txt requirements-portable-airflow.lock requirements-portable-dbt.lock ./
RUN if [ "$INSTALL_DEPS" = "true" ]; then pip install --no-cache-dir -r requirements-portable-airflow.lock && python -m venv /home/airflow/dbt-venv && /home/airflow/dbt-venv/bin/pip install --no-cache-dir -r requirements-portable-dbt.lock; fi
COPY --chown=airflow:root src ./src
COPY --chown=airflow:root scripts ./scripts
COPY --chown=airflow:root dags ./dags
COPY --chown=airflow:root sql ./sql
COPY --chown=airflow:root config ./config
COPY --chown=airflow:root dbt_foody ./dbt_foody
ENV PYTHONPATH=/app
